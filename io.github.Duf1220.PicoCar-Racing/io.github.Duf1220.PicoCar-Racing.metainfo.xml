<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.Duf1220.PicoCar-Racing</id>

  <name>PicoCar Racing</name>
  <summary>Race with tiny RC cars</summary>
  <summary xml:lang="cs">Závody s malými RC autíčky</summary>

  <developer id="io.github.duf1220">
    <name>UPSIDE DOWN VR</name>
  </developer>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>LicenseRef-proprietary=https://github.com/Duf1220/PicoCar-Racing/blob/main/LICENSE.txt</project_license>

  <description>
    <p>PicoCar Racing is an arcade racing game with tiny remote-controlled cars. Race through 9 tracks against 7 opponents and beat your best lap times.</p>
    <p xml:lang="cs">PicoCar Racing jsou arkádové závody s malými RC autíčky. Projeďte 9 tratí proti 7 soupeřům a překonejte své nejlepší časy na kolo.</p>
    <p>Controls: steer with the keyboard or a gamepad, pause the game with P.</p>
    <p xml:lang="cs">Ovládání: řídíte klávesnicí nebo gamepadem, hru pozastavíte klávesou P.</p>
  </description>

  <launchable type="desktop-id">io.github.Duf1220.PicoCar-Racing.desktop</launchable>

  <url type="homepage">https://upsidedownvr.cz/projekty</url>
  <url type="bugtracker">https://github.com/Duf1220/PicoCar-Racing/issues</url>

  <update_contact>office@upsidedownvr.cz</update_contact>

  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/Duf1220/PicoCar-Racing/main/screenshots/1.png</image>
      <caption>Racing on a track</caption>
      <caption xml:lang="cs">Závod na trati</caption>
    </screenshot>
  </screenshots>

  <branding>
    <color type="primary" scheme_preference="light">#f0d9c8</color>
    <color type="primary" scheme_preference="dark">#3b5566</color>
  </branding>

  <recommends>
    <control>keyboard</control>
    <control>gamepad</control>
  </recommends>
  <supports>
    <control>pointing</control>
  </supports>
  <requires>
    <display_length compare="ge">768</display_length>
  </requires>

  <content_rating type="oars-1.1" />

  <releases>
    <release version="1.0.0" date="2026-10-13">
      <description>
        <p>First tagged Linux release: 9 tracks, 8 cars on the grid, keyboard and gamepad controls.</p>
        <p xml:lang="cs">První označené vydání pro Linux: 9 tratí, 8 aut na startu, ovládání klávesnicí a gamepadem.</p>
      </description>
    </release>
  </releases>
</component>
